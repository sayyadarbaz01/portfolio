generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Feedback {
  id             String   @id @default(cuid())
  name           String
  role           String
  content        String
  date           String
  avatarGradient String
  createdAt      DateTime @default(now())
}
